#!/bin/bash
# task-clone <repo-url> [target-path]
#
# Set up a product code repo worktree under the entity NFS workspace.
# - bare clone 은 /data/cells/<cell>/repos/<slug>.git 에 cell-당 1개로 캐시 (NFS 공유)
# - 각 task 는 그 위에 worktree 만 add (sub-second)
# - 원격에 task 브랜치가 있으면 그 위에서 작업 이어가기, 없으면 main 에서 새 cut
#
# 환경변수: TASK_BRANCH, CELL_ID, WORKSPACE_NFS_PATH (워커가 부팅 시 set)
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "usage: task-clone <repo-url> [target-path]" >&2
    exit 2
fi

if [ -z "${TASK_BRANCH:-}" ]; then
    echo "task-clone: TASK_BRANCH env not set (cell이 repo_url 없는 워커?)" >&2
    exit 2
fi
if [ -z "${CELL_ID:-}" ]; then
    echo "task-clone: CELL_ID env not set" >&2
    exit 2
fi
if [ -z "${WORKSPACE_NFS_PATH:-}" ]; then
    echo "task-clone: WORKSPACE_NFS_PATH env not set" >&2
    exit 2
fi

url="$1"
default_name="$(basename "${url%.git}")"
target="${2:-${WORKSPACE_NFS_PATH}/${default_name}}"

# bare repo cache 슬러그: URL → cell repos/ 아래 디렉토리명
# (소문자 알파벳/숫자/하이픈만, 길이 64 cap).
url_slug=$(echo "$default_name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | tr -s '-' | sed 's/^-//;s/-$//' | head -c 64)
[ -z "$url_slug" ] && url_slug="repo"

bare_dir="/data/cells/${CELL_ID}/repos/${url_slug}.git"

# Pre-check: URL 접근 가능?
if ! git ls-remote "$url" HEAD >/dev/null 2>&1; then
    echo "task-clone: $url 접근 불가 — PAT 권한·URL·repo 존재 여부 확인 필요" >&2
    exit 3
fi

# bare clone (없으면 한 번만)
if [ ! -d "$bare_dir" ]; then
    mkdir -p "$(dirname "$bare_dir")"
    git clone --bare --filter=blob:none --no-tags "$url" "$bare_dir"
    echo "task-clone: bare cached → $bare_dir"
fi

# bare clone default fetch refspec 는 refs/heads/* 만 채우고 refs/remotes/origin/* 는
# 안 만든다 → worktree add 의 origin/main 참조 실패. 항상 remote-tracking 만들도록 재설정.
git -C "$bare_dir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
# 최신 origin 가져오기 (cheap, 같은 cell 의 다른 worktree 도 즉시 본다)
git -C "$bare_dir" fetch --prune --no-tags origin

# worktree target — NFS 절대경로로 등록 (bare 메타데이터 pod-agnostic).
# 전체 /data 마운트 하위 절대경로 (subPath 별칭 없음).
nfs_target="${WORKSPACE_NFS_PATH}/$(basename "$target")"

if [ ! -e "$nfs_target/.git" ]; then
    # base ref 결정: origin 에 TASK_BRANCH 있으면 그것, 없으면 origin/main
    if git -C "$bare_dir" show-ref --verify --quiet "refs/remotes/origin/${TASK_BRANCH}"; then
        base_ref="origin/${TASK_BRANCH}"
        echo "task-clone: existing remote branch 위에서 계속"
    else
        base_ref="origin/main"
        echo "task-clone: main 에서 새 브랜치 cut"
    fi
    mkdir -p "$(dirname "$nfs_target")"
    git -C "$bare_dir" worktree add -B "$TASK_BRANCH" "$nfs_target" "$base_ref"
else
    # 이전 pod 의 worktree 재사용. ff-only merge 시도.
    if git -C "$nfs_target" merge --ff-only "origin/${TASK_BRANCH}" >/dev/null 2>&1; then
        echo "task-clone: worktree resumed + ff merged"
    else
        echo "task-clone: worktree resumed (local preserved)"
    fi
fi

echo "task-clone: $target → ${TASK_BRANCH}"
